## beacon gateway configuration

# HTTP server
HTTP_ADDR=:8080
PUBLIC_BASE_URL=https://beacon.tarazel.com

# Storage
DB_PATH=data/beacon.db
LOG_LEVEL=info

# Set to true to bypass auth validation requirements during local dev.
DEV_MODE=false

## ----- MQTT (Frigate event bus) -----
MQTT_BROKER=tcp://phobos:1883
MQTT_CLIENT_ID=beacon-gateway
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_EVENTS_TOPIC=frigate/events

## ----- Frigate API access -----
# Point this at your Frigate instance. If the gateway runs alongside Frigate,
# an internal address (e.g. http://frigate:5000) is simplest and needs no
# Cloudflare. Use a public https URL only if Frigate is reached over the internet.
FRIGATE_BASE_URL=https://frigate.hydak.org
# OPTIONAL — only if Frigate sits behind Cloudflare Access. Leave both blank
# otherwise; the gateway injects these headers only when both are set.
# Create at: Cloudflare Zero Trust > Access > Service Auth > Service Tokens.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

## ----- Camera offline detection -----
# The gateway polls Frigate's /api/stats to tell when a camera stops delivering
# frames (ffmpeg crash, unreachable RTSP, camera down) and surfaces an "offline"
# tag on the camera API. No push is sent — a flapping camera would spam it.
# POLL_INTERVAL: how often to sample. OFFLINE_AFTER: how long with no frames
# before a camera is flagged (the debounce; 120s matches Frigate's own watchdog).
CAMERA_HEALTH_POLL_INTERVAL=30s
CAMERA_OFFLINE_AFTER=120s

## ----- go2rtc (WebRTC live view) -----
# When gateway runs on the same host as Frigate, localhost is the simplest path.
# Otherwise point at frigate.hydak.org/api/go2rtc or whatever exposes go2rtc to the gateway.
GO2RTC_BASE_URL=http://localhost:1984

# Cameras visible to the iOS app. JSON array, one entry per camera.
# - id           stable identifier the iOS client uses
# - display_name shown in the app
# - stream       go2rtc source name (use the H.264 substream, NOT the H.265 main stream)
# Example for a Reolink Duo 2 exposed as two go2rtc sources:
# CAMERAS_JSON=[{"id":"front_door_left","display_name":"Front Door (Left)","stream":"front_door_left_sub"},{"id":"front_door_right","display_name":"Front Door (Right)","stream":"front_door_right_sub"}]
CAMERAS_JSON=

## ----- App auth (Sign in with Apple + JWT) -----
# 32+ bytes of random base for HS256 JWT signing.
# Generate: openssl rand -base64 48
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=2160h

# Apple Sign In service identifier (Bundle ID for native iOS app)
APPLE_CLIENT_ID=org.tarazel.beacon
# Additional accepted Apple `aud` values (comma-separated) beyond APPLE_CLIENT_ID.
# The Android Sign-in-with-Apple web flow presents an Apple *Services ID* as the
# audience. The published app's Services ID (org.tarazel.beacon.signin) is ALWAYS
# accepted by default (baked in — see config.DefaultAppleServicesID), so running
# the published app needs nothing here. Only set this if you rebuild the app under
# your own Apple identity and need to accept a different Services ID, e.g.
# APPLE_ALLOWED_AUDIENCES=org.example.myapp.signin
APPLE_ALLOWED_AUDIENCES=

# Google Sign-In. Leave GOOGLE_CLIENT_ID empty to disable Google sign-in entirely
# (the /api/auth/google endpoint then returns 501). The value is the OAuth client
# id that the token's `aud` must match. Android's Credential Manager flow uses a
# Web (server) OAuth client id; set that here. The iOS OAuth client id (a second
# `aud`) goes in GOOGLE_ALLOWED_AUDIENCES (comma-separated), e.g.
#   GOOGLE_CLIENT_ID=1234567890-web.apps.googleusercontent.com
#   GOOGLE_ALLOWED_AUDIENCES=1234567890-ios.apps.googleusercontent.com
# Create these in Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_AUDIENCES=

# Comma-separated list of allowed Apple ID emails. New sign-ins outside this
# list are rejected UNLESS they present a valid invite code. If a family member
# uses "Hide my email", add their *@privaterelay.appleid.com address here, OR
# (easier) just send them an invite code from the app / beacon-admin.
APPLE_ALLOWED_EMAILS=

# Family roles: 'admin' manages users/cameras/settings and sees every camera;
# 'member' is a regular family user (scoped to specific cameras if you choose).
# The FIRST user to sign in is automatically made admin (the instance owner).
# Comma-separated emails here are also promoted to admin on sign-in. Manage roles
# and per-camera scope later with `beacon-admin set-role` / `set-cameras`, and add
# family members with `beacon-admin invite create` or the in-app Invites screen.
ADMIN_EMAILS=

## ----- Push relay (default: on — this is how push works) -----
# Push is delivered by the hosted relay (Beacon Pro). RELAY_URL defaults to
# Tarazel's relay, so you normally set NOTHING here: on the owner's first sign-in
# the gateway registers itself with the relay using that admin's verified
# Apple/Google identity (no secret to paste), starts a trial, and push just works.
# The gateway keeps all user/scope/mute logic + PII and forwards only
# {device_tokens, payload}; the relay holds the APNs/FCM keys and never sees the
# camera, label, or image.
#
# To override the relay endpoint, set RELAY_URL to your own. To turn the relay OFF
# and be fully self-contained (advanced — sign push yourself with your own .p8,
# see the APNs block below), set RELAY_URL=off.
# RELAY_URL=https://relay.tarazel.com
#
# RELAY_REGISTRATION_SECRET is the LEGACY shared-secret registration path, kept as
# a fallback. Leave it blank — identity registration (above) needs no secret.
# RELAY_REGISTRATION_SECRET=

## ----- APNs direct push (ADVANCED escape hatch — not needed with the relay) -----
# Only for running fully self-contained with RELAY_URL=off: sign + send pushes
# yourself with your own Apple .p8 (requires an Apple Developer account and, in
# practice, your own app build under your own bundle id). Leave blank to use the
# relay (the default).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=org.tarazel.beacon
# true while testing with TestFlight/debug builds; false for App Store/production builds.
APNS_USE_SANDBOX=true
