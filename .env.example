## beacon gateway configuration

# HTTP server
HTTP_ADDR=:8080
PUBLIC_BASE_URL=https://beacon.tarazel.com

# Storage
DB_PATH=data/beacon.db
LOG_LEVEL=info

# Set to true to bypass auth validation requirements during local dev.
DEV_MODE=false

## ----- MQTT (Frigate event bus) -----
MQTT_BROKER=tcp://phobos:1883
MQTT_CLIENT_ID=beacon-gateway
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_EVENTS_TOPIC=frigate/events

## ----- Frigate API access -----
# Point this at your Frigate instance. If the gateway runs alongside Frigate,
# an internal address (e.g. http://frigate:5000) is simplest and needs no
# Cloudflare. Use a public https URL only if Frigate is reached over the internet.
FRIGATE_BASE_URL=https://frigate.hydak.org
# OPTIONAL — only if Frigate sits behind Cloudflare Access. Leave both blank
# otherwise; the gateway injects these headers only when both are set.
# Create at: Cloudflare Zero Trust > Access > Service Auth > Service Tokens.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

## ----- go2rtc (WebRTC live view) -----
# When gateway runs on the same host as Frigate, localhost is the simplest path.
# Otherwise point at frigate.hydak.org/api/go2rtc or whatever exposes go2rtc to the gateway.
GO2RTC_BASE_URL=http://localhost:1984

# Cameras visible to the iOS app. JSON array, one entry per camera.
# - id           stable identifier the iOS client uses
# - display_name shown in the app
# - stream       go2rtc source name (use the H.264 substream, NOT the H.265 main stream)
# Example for a Reolink Duo 2 exposed as two go2rtc sources:
# CAMERAS_JSON=[{"id":"front_door_left","display_name":"Front Door (Left)","stream":"front_door_left_sub"},{"id":"front_door_right","display_name":"Front Door (Right)","stream":"front_door_right_sub"}]
CAMERAS_JSON=

## ----- App auth (Sign in with Apple + JWT) -----
# 32+ bytes of random base for HS256 JWT signing.
# Generate: openssl rand -base64 48
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=2160h

# Apple Sign In service identifier (Bundle ID for native iOS app)
APPLE_CLIENT_ID=org.tarazel.beacon
# Comma-separated list of allowed Apple ID emails. New sign-ins outside this
# list are rejected UNLESS they present a valid invite code. If a family member
# uses "Hide my email", add their *@privaterelay.appleid.com address here, OR
# (easier) just send them an invite code from the app / beacon-admin.
APPLE_ALLOWED_EMAILS=

# Family roles: 'admin' manages users/cameras/settings and sees every camera;
# 'member' is a regular family user (scoped to specific cameras if you choose).
# The FIRST user to sign in is automatically made admin (the instance owner).
# Comma-separated emails here are also promoted to admin on sign-in. Manage roles
# and per-camera scope later with `beacon-admin set-role` / `set-cameras`, and add
# family members with `beacon-admin invite create` or the in-app Invites screen.
ADMIN_EMAILS=

## ----- APNs (Apple Push) -----
# Path to your .p8 auth key downloaded from Apple Developer portal.
# NOTE: in relay mode (RELAY_URL set below) the gateway does NOT need a .p8 —
# the hosted relay holds the key. Leave APNS_KEY_PATH blank in that case.
APNS_KEY_PATH=secrets/AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=org.tarazel.beacon
# true while testing with TestFlight/debug builds; false for App Store/production builds.
APNS_USE_SANDBOX=true

## ----- Push relay (optional; the hosted/paid push path) -----
# Leave RELAY_URL blank to sign + send pushes directly with the .p8 above
# (DirectTransport — the self-hosted default). Set RELAY_URL to route pushes
# through the central first-party relay instead (RelayTransport): the gateway
# keeps all user/scope/mute logic + PII and forwards only {device_tokens,
# payload} to the relay, which holds the single APNs key. See deploy/relay/.
# RELAY_URL=https://abc123.execute-api.us-east-1.amazonaws.com
# Used once on first boot to register with the relay and obtain an instance
# token (then stored in the settings table; not needed after that).
# RELAY_REGISTRATION_SECRET=
